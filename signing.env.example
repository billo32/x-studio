# Copy to signing.env (git-ignored) and fill in once.

# Optional: by default the first "Developer ID Application" identity in the keychain is used.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Notarization — option 0 (simplest): a notarytool profile in the keychain, no password in files.
# Once:  xcrun notarytool store-credentials x-studio-notary --apple-id you@example.com --team-id TEAMID1234
#        (asks for an app-specific password: appleid.apple.com → Sign-In and Security → App-Specific Passwords)
# A profile created for another project works too — it belongs to the account, not the project.
# APPLE_NOTARY_PROFILE="x-studio-notary"

# Notarization — option A: App Store Connect API key
# App Store Connect → Users and Access → Integrations → Team Keys → "+", role Developer
# APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
# APPLE_API_KEY="ABCDE12345"
# APPLE_API_KEY_PATH="$HOME/.private_keys/AuthKey_ABCDE12345.p8"

# Notarization — option B: Apple ID + app-specific password
# APPLE_ID="you@example.com"
# APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
# APPLE_TEAM_ID="TEAMID1234"
